rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /courses/{courseId} {
      allow read: if resource.data.active == true || signedInAdmin();
      allow create, update, delete: if signedInAdmin();
    }

    // Keep your existing enquiries, sessions, admins and config rules.
    // Do not replace your complete production rules with this example alone.
  }
}
